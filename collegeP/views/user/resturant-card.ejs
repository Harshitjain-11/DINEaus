<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= restaurant.name %> | Swiggy Clone</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/user/restaurant-card.css">
</head>
<body>
  <%- include("../includes/flash") %>
 <%- include("../includes/navbar") %>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="#">Gwalior</a> / <%= restaurant.name %>
    </div>
  
    <h1 class="restaurant-name"><%= restaurant.name %></h1>
  
    <div class="info-card">
      <div class="rating">
        ⭐ <strong>4.7</strong> (26 ratings) • ₹<%= menuItems[0].costfortwo %> for two
      </div>
      <div class="cuisine">
        <%= restaurant.cuisines %>
      </div>
      <div class="outlet">
        <strong>Outlet:</strong> <%= restaurant.location %>
      </div>
      <div class="timing">
        <strong>⏱</strong> 40–45 mins
      </div>
      <div class="offer-strip">
        <!-- <img src="/images/onelite.png" height="20" /> -->
        <span>Free delivery on orders above ₹199</span>
      </div>
    </div>
  
    <h2 class="deals-title">Deals for you</h2>
    <div class="deals">
      <div class="deal-card">
        <div class="icon">%</div>
        <div class="deal-text">
          <strong>50% Off Upto ₹100</strong><br />
          <small>USE TRYNEW</small>
        </div>
      </div>
      <div class="deal-card">
        <div class="icon">%</div>
        <div class="deal-text">
          <strong>Flat ₹80 Off</strong><br />
          <small>USE FLATDEAL</small>
        </div>
      </div>
    </div>
  </div>
  <a href="/reserve/<%= restaurant.id %>">
  <button>Reserve / Seat / Preorder</button>
</a>


  <div class="menu-header">Menu</div>

  <div class="search-bar">
    <input type="text" id="dishSearch" placeholder="Search for dishes" />
    <i class="fa fa-search"></i>
    
  </div>
  
    
  <div class="filters" id="filterBar">
    <div class="filter-toggle" id="vegFilter" data-filter="veg">
      <span class="veg-icon"></span> Veg
    </div>
    <div class="filter-toggle" id="nonVegFilter" data-filter="nonveg">
      <span class="nonveg-icon"></span> Non-Veg
    </div>
    <!-- Bestseller button hidden: no bestseller field exists in the database schema -->
  </div>
  <!-- Cart action bar (Floating) -->
  <div id="cartBar" class="floating-cart" style="<%= cartCount > 0 ? 'display:flex;' : 'display:none;' %>">
    <div class="cart-info">
      <i class="fa fa-shopping-cart"></i>
      <span id="cartCount"><%= cartCount %> item(s) added</span>
    </div>
    <a href="/cart/checkout" class="view-cart-btn">View Cart <i class="fa fa-arrow-right"></i></a>
  </div>
  

  

  <div class="menu-section">
    <h3>Recommended (<%= menuItems.length %>)</h3>
  
    <% menuItems.forEach(item => { %>
      <div
        class="menu-item <%= Number(item.is_available) === 1 ? '' : 'out-of-stock' %>"
        data-item-id="<%= item.id %>"
        data-name="<%= item.item_name.toLowerCase() %>"
        data-veg="<%= Number(item.is_veg) === 1 ? 'true' : 'false' %>">

        <div class="menu-left">
          <!-- <img
            src="<%= item.vegNonveg === 'veg' ? '/veg-icon.svg' : '/non-veg-icon.svg' %>"
            class="veg-icon"
            alt="<%= item.vegNonveg %>"
          /> -->
          <h4><%= item.item_name %></h4>
          <p class="price">₹<%= item.price %></p>
          <p class="more-link"><button>More Details</button></p>
        </div>
  
        <div class="menu-right">
          
          <% if (Number(item.is_available) === 0) { %>
  <div class="out-badge">OUT OF STOCK</div>
<% } %>

          <!-- Individual dish image: common_image first (admin-uploaded), then name-based fallback, then OCR photo last -->
          <img
            src="<%= item.common_image
                  ? '/uploads/menus/' + item.common_image
                  : '/' + getCommonImageName(item.item_name) %>"
            alt="<%= item.item_name %>"
          >

          <% if (Number(item.is_available) === 1) { %>
            <button
              class="add-btn add-to-cart-btn"
              data-item-id="<%= item.id %>"
            >
              ADD
            </button>
          <% } else { %>
            <button
              class="add-btn add-to-cart-btn"
              disabled
              style="background:#aaa;cursor:not-allowed;"
            >
              UNAVAILABLE
            </button>
          <% } %>
          
          
          <p class="customisable">Customisable</p>
        </div>
      </div>
    <% }) %>
  </div>
  <div id="noResult">
  <div class="icon">🍽️</div>
  <h4>No dishes found</h4>
  <p>Try searching with a different keyword.</p>
</div>

  <script>
  /* ── Shared helpers ────────────────────────────────── */
  const searchInput  = document.getElementById("dishSearch");
  const allMenuItems = document.querySelectorAll(".menu-item");
  const noResult     = document.getElementById("noResult");
  const cartBar      = document.getElementById("cartBar");
  const cartCountEl  = document.getElementById("cartCount");

  let activeFilter = null;   // null | 'veg' | 'nonveg'
  let cartItemCount = <%= typeof cartCount !== 'undefined' ? cartCount : 0 %>;

  function applyVisibility() {
    const keyword = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    allMenuItems.forEach(item => {
      const dishName = item.dataset.name;
      const isVeg    = item.dataset.veg === 'true';

      const matchSearch = !keyword || dishName.includes(keyword);
      const matchFilter =
        !activeFilter ||
        (activeFilter === 'veg'    &&  isVeg) ||
        (activeFilter === 'nonveg' && !isVeg);

      if (matchSearch && matchFilter) {
        item.style.display = "flex";
        visibleCount++;
      } else {
        item.style.display = "none";
      }
    });

    noResult.style.display = visibleCount === 0 ? "block" : "none";
  }

  /* ── Search ─────────────────────────────────────────── */
  searchInput.addEventListener("input", applyVisibility);

  /* ── Veg / Non-Veg filters ──────────────────────────── */
  document.getElementById("vegFilter").addEventListener("click", function () {
    if (activeFilter === 'veg') {
      activeFilter = null;
      this.classList.remove("active");
    } else {
      activeFilter = 'veg';
      this.classList.add("active");
      document.getElementById("nonVegFilter").classList.remove("active");
    }
    applyVisibility();
  });

  document.getElementById("nonVegFilter").addEventListener("click", function () {
    if (activeFilter === 'nonveg') {
      activeFilter = null;
      this.classList.remove("active");
    } else {
      activeFilter = 'nonveg';
      this.classList.add("active");
      document.getElementById("vegFilter").classList.remove("active");
    }
    applyVisibility();
  });

  /* ── AJAX Add-to-cart ───────────────────────────────── */
  document.querySelectorAll(".add-to-cart-btn").forEach(btn => {
    if (btn.disabled) return;   // skip UNAVAILABLE buttons

    btn.addEventListener("click", function () {
      const itemId = this.dataset.itemId;
      if (!itemId) return;

      // Disable button during request to prevent double-clicks
      btn.disabled = true;
      btn.textContent = "...";

      fetch(`/cart/checkout?item_id=${itemId}`, { method: "GET", headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(res => {
          if (!res.ok) throw new Error("Network response was not ok");
          // Item added successfully — update counter, restore button as stepper
          cartItemCount++;
          cartCountEl.textContent = cartItemCount + " item(s) added";
          cartBar.style.display = "flex";

          // Transform ADD → simple ✓ confirmation then back to ADD
          btn.textContent = "✓ Added";
          btn.style.background = "#4caf50";
          setTimeout(() => {
            btn.textContent = "ADD";
            btn.style.background = "";
            btn.disabled = false;
          }, 1200);
        })
        .catch(() => {
          btn.textContent = "ADD";
          btn.disabled = false;
          alert("Could not add item. Please try again.");
        });
    });
  });
</script>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  const RESTAURANT_ID = "<%= restaurant.id %>";
  socket.emit("joinRestaurantRoom", RESTAURANT_ID);

  socket.on("menu:stockUpdate", ({ itemId, is_available }) => {
    const itemCard = document.querySelector(
      `.menu-item[data-item-id="${itemId}"]`
    );

    if (!itemCard) return;

    const addBtn = itemCard.querySelector(".add-to-cart-btn");
    let badge = itemCard.querySelector(".out-badge");

    if (!is_available) {
      // ❌ OUT OF STOCK
      itemCard.classList.add("out-of-stock");

      if (addBtn) {
        addBtn.disabled = true;
        addBtn.innerText = "UNAVAILABLE";
        addBtn.style.background = "#aaa";
        addBtn.style.cursor = "not-allowed";
      }

      if (!badge) {
        badge = document.createElement("div");
        badge.className = "out-badge";
        badge.innerText = "OUT OF STOCK";
        itemCard.querySelector(".menu-right").appendChild(badge);
      }

    } else {
      // ✅ BACK IN STOCK
      itemCard.classList.remove("out-of-stock");

      if (addBtn) {
        addBtn.disabled = false;
        addBtn.innerText = "ADD";
        addBtn.style.background = "";
        addBtn.style.cursor = "pointer";
      }

      if (badge) badge.remove();
    }
  });
</script>


</body>
</html>

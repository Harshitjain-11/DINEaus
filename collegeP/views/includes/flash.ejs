<% if (success && success.length) { %>
  <div class="alert-wrapper alert-success-wrapper">
    <div class="alert alert-success">
      <div class="alert-icon-container">
        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div class="alert-content">
        <h4 class="alert-title">Success!</h4>
        <p class="alert-message"><%= success[0] %></p>
      </div>
      <button class="alert-close" onclick="this.closest('.alert-wrapper').remove()" aria-label="Close alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert-wrapper alert-error-wrapper">
    <div class="alert alert-error">
      <div class="alert-icon-container">
        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <div class="alert-content">
        <h4 class="alert-title">Oops!</h4>
        <p class="alert-message"><%= error[0] %></p>
      </div>
      <button class="alert-close" onclick="this.closest('.alert-wrapper').remove()" aria-label="Close alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
<% } %>

